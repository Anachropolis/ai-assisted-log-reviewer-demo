# Copy this file to .env and replace placeholder values.

# Required for OpenAI API calls
OPENAI_API_KEY=your_openai_api_key_here

# LLM used for structured log review
OPENAI_MODEL=gpt-4.1-mini

# Embedding model used for vector search
EMBEDDING_MODEL=text-embedding-3-small

# Local vector store settings
CHROMA_COLLECTION_NAME=operator-log-references
CHROMA_PERSIST_DIR=chroma_db

# Mock API settings
MOCK_API_BASE_URL=http://127.0.0.1:8000